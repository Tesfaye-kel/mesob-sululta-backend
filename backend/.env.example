# Booking, cancellation, and delivery approval use transactions; configure a replica set.
MONGO_URI=mongodb://localhost:27017/mesob_sululta?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
OFFICE_ADMIN_EMAIL=
OFFICE_ADMIN_PASSWORD=
FEEDBACK_OFFICER_EMAIL=
FEEDBACK_OFFICER_PASSWORD=

PORT=5000

# ─── Email Notification (SMTP) ───────────────────────────────────
# Configure these to enable email notifications when a contact form is submitted.
# The email will be sent to the email address configured in the admin Contact settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: path to a trusted SMTP TLS CA certificate provided by your mail/network administrator.
SMTP_TLS_CA_FILE=

# ─── SMS Notification ────────────────────────────────────────────
# Configure these to enable SMS notifications when a contact form is submitted.
# The SMS will be sent to the phone number configured in the admin Contact settings.
# Supported providers: africastalking, twilio
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=MESOB
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Citizen identity verification. Use the authorized FAN provider in production.
FAN_IDENTITY_PROVIDER=mock
FAN_IDENTITY_URL=
FAN_IDENTITY_API_KEY=
FAN_MOCK_IDENTITIES={}
# Optional override; otherwise FAN values are hashed using JWT_SECRET.
FAN_HASH_SECRET=
PHONE_ENCRYPTION_KEY=replace-with-64-hex-characters
OTP_HASH_SECRET=replace-with-a-long-random-secret
DEV_OTP_LOG=false
FRONTEND_URL=http://localhost:5173
